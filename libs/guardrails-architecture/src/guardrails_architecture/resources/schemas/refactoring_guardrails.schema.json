{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "include", "ignore", "rules"],
  "properties": {
    "version": {"const": 1},
    "include": {"type": "array", "items": {"type": "string"}},
    "ignore": {"type": "array", "items": {"type": "string"}},
    "rules": {
      "type": "object",
      "properties": {
        "ban_wildcard_imports": {"type": "boolean"},
        "max_relative_import_level": {"type": "integer"},
        "detect_internal_cycles": {"type": "boolean"},
        "cycle_roots": {"type": "array", "items": {"type": "string"}},
        "directional_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "may_import"],
            "properties": {
              "from": {"type": "string"},
              "may_import": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "forbid_concrete_imports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scope", "forbidden_prefixes"],
            "properties": {
              "scope": {"type": "string"},
              "forbidden_prefixes": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "composition_roots": {"type": "array", "items": {"type": "string"}},
        "allow_concrete_wiring_only_in": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
