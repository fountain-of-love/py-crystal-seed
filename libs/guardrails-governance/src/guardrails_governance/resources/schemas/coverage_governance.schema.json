{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "coverage_file", "baseline_file", "thresholds", "parity", "scope"],
  "properties": {
    "version": {"const": 1},
    "coverage_file": {"type": "string", "minLength": 1},
    "baseline_file": {"type": "string", "minLength": 1},
    "thresholds": {
      "type": "object",
      "required": ["global_min", "package_min"],
      "properties": {
        "global_min": {"type": "number"},
        "package_min": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      }
    },
    "parity": {
      "type": "object",
      "required": ["enabled", "max_regression_points"],
      "properties": {
        "enabled": {"type": "boolean"},
        "max_regression_points": {"type": "number"}
      }
    },
    "scope": {
      "type": "object",
      "required": ["include", "exclude"],
      "properties": {
        "include": {"type": "array", "items": {"type": "string"}},
        "exclude": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
